pkgname=solitaire-omarchy
_upstream_version=0.1.0
_release_revision_count=0
_commit=dc193f4cea8510ccb8bc803ebd457ecd28d9d8bc
_release_sha256=6db5400d5d384302d43bb218618468233ab27f850e76580f21fb46d25fac43bf
_release_evidence_ci=https://github.com/rohan-patnaik/Solitaire/actions/runs/32551758881
pkgver=${_upstream_version}.r${_release_revision_count}.g${_commit::7}
pkgrel=1
pkgdesc="Original offline collection of classic patience games"
arch=('x86_64')
url="https://github.com/rohan-patnaik/Solitaire"
license=('MIT')
depends=('fontconfig' 'wayland' 'libxkbcommon')
makedepends=('cargo' 'git')

_normalize_sha256() {
  local normalized=${1,,}
  [[ $normalized =~ ^[0-9a-f]{64}$ ]] || return 1
  printf '%s' "$normalized"
}

if [[ ${SOLITAIRE_SOURCE_ARCHIVE+x} != ${SOLITAIRE_EXPECTED_REVISION+x} ]]; then
  printf '%s\n' \
    'SOLITAIRE_SOURCE_ARCHIVE and SOLITAIRE_EXPECTED_REVISION must be provided together' >&2
  return 1
fi

if [[ ${SOLITAIRE_SOURCE_ARCHIVE+x} ]]; then
  if [[ -z $SOLITAIRE_SOURCE_ARCHIVE ]]; then
    printf '%s\n' 'SOLITAIRE_SOURCE_ARCHIVE must not be empty' >&2
    return 1
  fi
  if [[ ! $SOLITAIRE_EXPECTED_REVISION =~ ^[0-9a-f]{40}$ ]]; then
    printf '%s\n' 'SOLITAIRE_EXPECTED_REVISION must be a full Git SHA' >&2
    return 1
  fi
  if ! _source_sha256=$(_normalize_sha256 "${SOLITAIRE_SOURCE_SHA256:-}"); then
    printf '%s\n' 'SOLITAIRE_SOURCE_SHA256 must be exactly 64 hexadecimal characters' >&2
    return 1
  fi
  source=("$SOLITAIRE_SOURCE_ARCHIVE")
  sha256sums=("$_source_sha256")
  _source_dir=Solitaire
else
  _release_sha256_input=$_release_sha256
  if [[ ${SOLITAIRE_RELEASE_SHA256+x} ]]; then
    _release_sha256_input=$SOLITAIRE_RELEASE_SHA256
  fi
  if ! _release_archive_sha256=$(_normalize_sha256 "$_release_sha256_input"); then
    printf '%s\n' 'SOLITAIRE_RELEASE_SHA256 must be a verified 64-character hexadecimal digest' >&2
    return 1
  fi
  source=("Solitaire-${_commit}.tar.gz::https://github.com/rohan-patnaik/Solitaire/archive/${_commit}.tar.gz")
  sha256sums=("$_release_archive_sha256")
  _source_dir="Solitaire-${_commit}"
fi

pkgver() {
  local revision=${SOLITAIRE_EXPECTED_REVISION:-$_commit}
  [[ $revision =~ ^[0-9a-f]{40}$ ]] || return 1
  printf '%s.r%s.g%s' "$_upstream_version" "$_release_revision_count" "${revision:0:7}"
}

prepare() {
  cd "$_source_dir"
  local revision=${SOLITAIRE_EXPECTED_REVISION:-$_commit}
  [[ $revision =~ ^[0-9a-f]{40}$ ]] || return 1
  if [[ -n ${SOLITAIRE_SOURCE_ARCHIVE:-} ]]; then
    [[ -f .solitaire-source-revision ]] || return 1
    [[ $(<.solitaire-source-revision) == "$revision" ]] || return 1
  fi
  printf '%s\n' "$revision" > .solitaire-source-revision
}

build() {
  cd "$_source_dir"
  cargo build --locked --release
}

check() {
  cd "$_source_dir"
  cargo test --locked --all-targets --all-features
}

package() {
  cd "$_source_dir"
  install -Dm755 target/release/solitaire "$pkgdir/usr/bin/solitaire"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 .solitaire-source-revision \
    "$pkgdir/usr/share/$pkgname/source-revision"
}
