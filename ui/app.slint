import { Button, ComboBox, HorizontalBox, LineEdit, ScrollView, VerticalBox } from "std-widgets.slint";

export struct UiCard {
    label: string,
    red: bool,
    face-up: bool,
    selected: bool,
    accessible-label: string,
}

export struct UiColumn { cards: [UiCard] }

export struct UiTriPeaksCard {
    card: UiCard,
    present: bool,
}

export struct UiPyramidCard {
    card: UiCard,
    present: bool,
}

component CardFace inherits Rectangle {
    in property <UiCard> card;
    callback activated;

    width: 104px;
    height: 142px;
    border-radius: 9px;
    border-width: card-focus.has-focus ? 5px : (card.selected ? 4px : 2px);
    border-color: card-focus.has-focus ? #ffffff : (card.selected ? #f4c95d : (card.face-up ? #d5cbb7 : #8bc2b3));
    background: card.face-up ? #fffaf0 : #1f6b61;
    accessible-role: button;
    accessible-label: card.accessible-label;
    accessible-action-default => { root.activated(); }

    if !card.face-up: Rectangle {
        x: 9px;
        y: 9px;
        width: parent.width - 18px;
        height: parent.height - 18px;
        border-radius: 5px;
        border-width: 2px;
        border-color: #a7d4c5;
        background: #24554f;

        Rectangle {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            border-radius: 28px;
            border-width: 3px;
            border-color: #d0a955;
            background: #2c665d;
        }
    }

    if card.face-up: Text {
        x: 11px;
        y: 7px;
        text: card.label;
        color: card.red ? #a62d3c : #172b2a;
        font-size: 26px;
        font-weight: 700;
    }

    TouchArea { clicked => { root.activated(); } }
    card-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                if (!event.repeat) { root.activated(); }
                return accept;
            }
            return reject;
        }
    }
}

component EmptySlot inherits Rectangle {
    in property <string> label;
    callback activated;
    width: 104px;
    height: 142px;
    border-radius: 9px;
    border-width: slot-focus.has-focus ? 5px : 2px;
    border-color: slot-focus.has-focus ? #ffffff : #80a49b;
    background: #ffffff0d;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { root.activated(); }

    Text {
        text: parent.label;
        color: #b9cec7;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    TouchArea { clicked => { root.activated(); } }
    slot-focus := FocusScope {
        x: 0;
        width: 0;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                if (!event.repeat) { root.activated(); }
                return accept;
            }
            return reject;
        }
    }
}

export component AppWindow inherits Window {
    title: "Solitaire — " + root.game-kind;
    width: 1180px;
    height: 820px;
    background: #123e38;

    in property <string> game-kind: "Klondike";
    in property <[UiColumn]> columns;
    in property <[UiCard]> foundations;
    in property <[UiCard]> free-cells;
    in property <[bool]> free-cell-occupied;
    in property <[UiTriPeaksCard]> tripeaks-cards;
    in property <[UiPyramidCard]> pyramid-cards;
    in property <UiCard> waste-card;
    in property <bool> has-waste;
    in property <int> stock-count;
    in property <int> score;
    in property <int> moves;
    in property <int> completed-runs;
    in property <int> longest-column;
    in property <int> deal-id;
    in property <string> deal-number;
    in property <int> redeals;
    in property <int> redeals-remaining;
    in property <string> status-text: "Ready";
    in property <string> local-statistics: "Local: 0 played · 0 won";
    in property <bool> can-undo;
    in property <bool> can-redo;
    in property <bool> has-unsaved-changes;
    in property <bool> has-any-unsaved-changes;
    in property <bool> has-pending-new-deal;
    in property <bool> pending-deal-is-restart;
    in property <bool> has-pending-save-conflict;
    in-out property <string> klondike-draw-mode: "Draw 1";
    in-out property <int> klondike-draw-index: 0;
    in-out property <string> klondike-scoring-mode: "Standard";
    in-out property <int> klondike-scoring-index: 0;
    in-out property <string> klondike-redeal-limit: "Unlimited";
    in-out property <int> klondike-redeal-index: 0;
    in-out property <string> spider-suit-mode: "1 suit";
    in-out property <int> spider-suit-index: 0;
    in property <string> spider-suit-mode-active: "1 suit";
    in-out property <string> tripeaks-rule-mode: "Standard";
    in-out property <int> tripeaks-rule-index: 0;
    in property <bool> tripeaks-wraparound-active: false;
    in-out property <string> pyramid-redeal-limit: "2 redeals";
    in-out property <int> pyramid-redeal-index: 2;
    in property <int> pyramid-max-redeals-active: 2;
    in-out property <string> freecell-deal-number-entry: "";

    callback select-game(string);
    callback new-game(string);
    callback new-freecell-deal(string);
    callback draw-stock;
    callback waste-activated;
    callback tableau-activated(int, int);
    callback foundation-activated(int);
    callback spider-deal-stock;
    callback spider-tableau-activated(int, int);
    callback freecell-cascade-activated(int, int);
    callback freecell-cell-activated(int);
    callback freecell-foundation-activated(int);
    callback tripeaks-draw-stock;
    callback tripeaks-tableau-activated(int);
    callback pyramid-draw-stock;
    callback pyramid-waste-activated;
    callback pyramid-tableau-activated(int);
    callback undo-requested;
    callback redo-requested;
    callback hint-requested;
    callback restart-deal-requested;
    callback autocomplete-requested;
    callback retry-save-requested;
    callback discard-progress-and-start-requested;
    callback cancel-new-deal-requested;
    callback confirm-missing-save-requested;
    callback discard-and-close-requested;
    callback reload-disk-requested;
    pure callback fan-spacing(int, float) -> float;
    pure callback tripeaks-x(int, float) -> float;
    pure callback pyramid-x(int, float) -> float;
    pure callback pyramid-y(int) -> float;

    VerticalBox {
        padding: 22px;
        spacing: 12px;

        HorizontalBox {
            spacing: 10px;
            vertical-stretch: 0;
            min-height: 44px;
            preferred-height: 44px;
            max-height: 44px;
            Text {
                text: "Solitaire";
                color: #fff3dd;
                font-size: 34px;
                font-weight: 700;
                vertical-alignment: center;
            }
            game-picker := ComboBox {
                model: ["Klondike", "Spider", "FreeCell", "Pyramid", "TriPeaks"];
                current-value: root.game-kind;
                accessible-label: "Game picker";
            }
            Button {
                text: "Open";
                accessible-label: "Open selected game";
                clicked => { root.select-game(game-picker.current-value); }
            }
            Button {
                text: "Reload disk copy";
                enabled: root.has-unsaved-changes || root.has-pending-save-conflict;
                accessible-label: root.has-pending-save-conflict
                    ? "Reload the newer disk copy and resolve pending deal-change ownership"
                    : "Discard in-memory changes and reload the newer disk copy";
                clicked => { root.reload-disk-requested(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.game-kind == "Spider"
                    ? "Score  " + root.score + "     Moves  " + root.moves + "     Runs  " + root.completed-runs + "/8     Mode  " + root.spider-suit-mode-active
                    : (root.game-kind == "FreeCell"
                        ? "Home  " + root.score + "/52     Moves  " + root.moves + "     Deal  " + root.deal-number
                        : (root.game-kind == "TriPeaks"
                            ? "Score  " + root.score + "     Moves  " + root.moves + "     Deal  " + root.deal-number
                                + "     Rule  " + (root.tripeaks-wraparound-active ? "Ace-King wrap" : "Standard")
                            : (root.game-kind == "Pyramid"
                                ? "Score  " + root.score + "     Moves  " + root.moves + "     Deal  " + root.deal-number + "     Redeals  " + root.redeals + "/" + root.pyramid-max-redeals-active
                                : "Score  " + root.score + "     Moves  " + root.moves + "     Redeals  " + root.redeals
                                    + (root.redeals-remaining < 0 ? " / unlimited" : "     Remaining  " + root.redeals-remaining))));
                color: #dce9e3;
                font-size: 17px;
                vertical-alignment: center;
            }
            if root.game-kind == "Spider": HorizontalBox {
                spacing: 8px;
                spider-mode := ComboBox {
                    model: ["1 suit", "2 suits", "4 suits"];
                    current-value <=> root.spider-suit-mode;
                    current-index <=> root.spider-suit-index;
                    enabled: !root.has-pending-new-deal;
                    accessible-label: "Suit count for a new Spider deal";
                }
                Button {
                    text: "New deal";
                    enabled: !root.has-pending-new-deal;
                    accessible-label: "Start the next Spider deal with the selected suit count";
                    clicked => { root.new-game(root.spider-suit-mode); }
                }
            }
            if root.game-kind == "TriPeaks": HorizontalBox {
                spacing: 8px;
                tripeaks-rule := ComboBox {
                    model: ["Standard", "Ace-King wrap"];
                    current-value <=> root.tripeaks-rule-mode;
                    current-index <=> root.tripeaks-rule-index;
                    enabled: !root.has-pending-new-deal;
                    accessible-label: "Rank rule for a new TriPeaks deal";
                }
                Button {
                    text: "New deal";
                    enabled: !root.has-pending-new-deal;
                    accessible-label: "Start the next TriPeaks deal with the selected rank rule";
                    clicked => { root.new-game(root.tripeaks-rule-mode); }
                }
            }
            if root.game-kind == "Pyramid": HorizontalBox {
                spacing: 8px;
                pyramid-redeals := ComboBox {
                    model: ["No redeals", "1 redeal", "2 redeals"];
                    current-value <=> root.pyramid-redeal-limit;
                    current-index <=> root.pyramid-redeal-index;
                    enabled: !root.has-pending-new-deal;
                    accessible-label: "Stock redeal limit for a new Pyramid deal";
                }
                Button {
                    text: "New deal";
                    enabled: !root.has-pending-new-deal;
                    accessible-label: "Start the next Pyramid deal with the selected redeal limit";
                    clicked => { root.new-game(root.pyramid-redeal-limit); }
                }
            }
        }

        HorizontalBox {
            spacing: 10px;
            vertical-stretch: 0;
            min-height: 40px;
            preferred-height: 40px;
            max-height: 40px;
            Button { text: "Undo"; enabled: root.can-undo; clicked => { root.undo-requested(); } }
            Button { text: "Redo"; enabled: root.can-redo; clicked => { root.redo-requested(); } }
            Button { text: "Hint"; clicked => { root.hint-requested(); } }
            if !root.has-pending-new-deal: Button {
                text: "Restart deal";
                accessible-label: "Restart the current deal with the same deal number and rules";
                clicked => { root.restart-deal-requested(); }
            }
            Text {
                text: root.local-statistics;
                accessible-label: "Device-local statistics for the active game: " + root.local-statistics;
                color: #dce9e3;
                vertical-alignment: center;
            }
            Button {
                text: "Retry save";
                enabled: root.has-unsaved-changes || root.has-pending-new-deal;
                accessible-label: "Retry saving changes kept in memory";
                clicked => { root.retry-save-requested(); }
            }
            if root.has-pending-new-deal: Button {
                text: root.pending-deal-is-restart ? "Discard and restart" : "Discard and start";
                accessible-label: root.pending-deal-is-restart
                    ? "Discard current unsaved progress and restart this deal"
                    : "Discard current unsaved progress and start the pending new deal";
                clicked => { root.discard-progress-and-start-requested(); }
            }
            if root.has-pending-new-deal: Button {
                text: root.pending-deal-is-restart ? "Cancel restart" : "Cancel new deal";
                accessible-label: root.pending-deal-is-restart
                    ? "Cancel the pending restart and preserve the current game"
                    : "Cancel the pending new deal and preserve the current game";
                clicked => { root.cancel-new-deal-requested(); }
            }
            if root.has-pending-save-conflict: Button {
                text: "Confirm missing save";
                accessible-label: "Refresh ownership only if a locked recheck confirms the save is missing";
                clicked => { root.confirm-missing-save-requested(); }
            }
            if root.has-any-unsaved-changes: Button {
                text: "Discard and close";
                accessible-label: "Discard all unsaved progress and close Solitaire";
                clicked => { root.discard-and-close-requested(); }
            }
            if root.game-kind == "Klondike": Button {
                text: "Finish safe moves";
                clicked => { root.autocomplete-requested(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.game-kind == "Klondike": HorizontalBox {
            spacing: 10px;
            vertical-stretch: 0;
            min-height: 40px;
            preferred-height: 40px;
            max-height: 40px;
            Text {
                text: "Next Klondike deal";
                color: #dce9e3;
                vertical-alignment: center;
            }
            draw-mode := ComboBox {
                model: ["Draw 1", "Draw 3"];
                current-value <=> root.klondike-draw-mode;
                current-index <=> root.klondike-draw-index;
                enabled: !root.has-pending-new-deal;
                accessible-label: "Draw mode for a new Klondike deal";
            }
            scoring-mode := ComboBox {
                model: ["Standard", "Vegas"];
                current-value <=> root.klondike-scoring-mode;
                current-index <=> root.klondike-scoring-index;
                enabled: !root.has-pending-new-deal;
                accessible-label: "Scoring mode for a new Klondike deal";
            }
            redeal-limit := ComboBox {
                model: ["Unlimited", "1 redeal", "3 redeals"];
                current-value <=> root.klondike-redeal-limit;
                current-index <=> root.klondike-redeal-index;
                enabled: !root.has-pending-new-deal;
                accessible-label: "Stock redeal limit for a new Klondike deal";
            }
            Button {
                text: "New deal";
                enabled: !root.has-pending-new-deal;
                accessible-label: "Start a new Klondike deal";
                clicked => {
                    root.new-game(root.klondike-draw-mode + " · " + root.klondike-scoring-mode + " · " + root.klondike-redeal-limit);
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.game-kind == "FreeCell": HorizontalBox {
            spacing: 10px;
            vertical-stretch: 0;
            min-height: 40px;
            preferred-height: 40px;
            max-height: 40px;
            Text {
                text: "Choose FreeCell deal";
                color: #dce9e3;
                vertical-alignment: center;
            }
            freecell-deal-number := LineEdit {
                horizontal-stretch: 1;
                text <=> root.freecell-deal-number-entry;
                placeholder-text: "Decimal deal number";
                input-type: InputType.number;
                enabled: !root.has-pending-new-deal;
                accessible-label: "FreeCell deal number";
                accepted(value) => { root.new-freecell-deal(value); }
            }
            Button {
                text: "Open deal";
                enabled: !root.has-pending-new-deal;
                accessible-label: "Open the entered FreeCell deal number";
                clicked => { root.new-freecell-deal(root.freecell-deal-number-entry); }
            }
            Button {
                text: "Next deal";
                enabled: !root.has-pending-new-deal;
                accessible-label: "Start the next numbered FreeCell deal";
                clicked => { root.new-game("Next numbered deal"); }
            }
        }

        status-surface := Rectangle {
            vertical-stretch: 0;
            min-height: 80px;
            preferred-height: 80px;
            max-height: 80px;
            border-radius: 10px;
            border-width: status-focus.has-focus ? 3px : 1px;
            border-color: status-focus.has-focus ? #ffffff : #577d74;
            background: #0d332e;
            accessible-role: groupbox;
            accessible-label: "Status details. Use arrow keys to scroll status messages";

            Text {
                x: 14px;
                y: 4px;
                height: 16px;
                text: "Status details — arrow keys scroll · " + (root.game-kind == "Spider"
                    ? "Spider " + root.spider-suit-mode-active + " uses descending same-suit movable runs. Build by rank; complete King-to-Ace suited runs."
                    : (root.game-kind == "FreeCell"
                        ? "Use four free cells to build alternating cascades and ascending suit foundations."
                        : (root.game-kind == "TriPeaks"
                            ? (root.tripeaks-wraparound-active
                                ? "TriPeaks Ace-King wrap treats Ace and King as adjacent. All play stays on this device."
                                : "Standard TriPeaks uses no rank wraparound. All play stays on this device.")
                            : (root.game-kind == "Pyramid"
                                ? "Pyramid uses pair-to-13 rules and " + root.pyramid-max-redeals-active + (root.pyramid-max-redeals-active == 1 ? " stock redeal. " : " stock redeals. ") + "All play stays on this device."
                                : "Choose a face-up card or run, then choose its destination. All play stays on this device."))));
                color: #aac5bd;
                font-size: 11px;
            }

            status-scroll := ScrollView {
                x: 14px;
                y: 20px;
                width: parent.width - 28px;
                height: parent.height - 26px;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, status-text.preferred-height + 4px);
                vertical-scrollbar-policy: always-on;
                horizontal-scrollbar-policy: always-off;
                mouse-drag-pan-enabled: true;

                status-text := Text {
                    width: status-scroll.visible-width - 18px;
                    height: status-scroll.viewport-height;
                    text: root.status-text;
                    wrap: char-wrap;
                    accessible-live-region: polite;
                    accessible-label: "Game status: " + root.status-text;
                    color: #f4d78e;
                    font-size: 16px;
                    horizontal-alignment: left;
                    vertical-alignment: top;
                }
            }

            status-focus := FocusScope {
                x: 0;
                width: 0;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        status-scroll.viewport-y = min(0px, status-scroll.viewport-y + 20px);
                        return accept;
                    } else if (event.text == Key.DownArrow) {
                        status-scroll.viewport-y = max(
                            status-scroll.visible-height - status-scroll.viewport-height,
                            status-scroll.viewport-y - 20px,
                        );
                        return accept;
                    } else if (event.text == Key.PageUp) {
                        status-scroll.viewport-y = min(
                            0px,
                            status-scroll.viewport-y + status-scroll.visible-height,
                        );
                        return accept;
                    } else if (event.text == Key.PageDown) {
                        status-scroll.viewport-y = max(
                            status-scroll.visible-height - status-scroll.viewport-height,
                            status-scroll.viewport-y - status-scroll.visible-height,
                        );
                        return accept;
                    }
                    return reject;
                }
            }
        }

        if root.game-kind == "Klondike": Rectangle {
            background: #0d332e;
            border-radius: 18px;
            vertical-stretch: 1;

            Rectangle {
                x: 24px;
                y: 22px;
                width: parent.width - 48px;
                height: 150px;
                EmptySlot {
                    label: root.stock-count > 0 ? root.stock-count + " cards\nDraw" : "Recycle";
                    activated => { root.draw-stock(); }
                }
                if root.has-waste: CardFace {
                    x: 126px;
                    card: root.waste-card;
                    activated => { root.waste-activated(); }
                }
                if !root.has-waste: EmptySlot {
                    x: 126px;
                    label: "Waste";
                    activated => { root.waste-activated(); }
                }
                for foundation[index] in root.foundations: CardFace {
                    x: parent.width - (4 - index) * 116px;
                    card: foundation;
                    activated => { root.foundation-activated(index); }
                }
            }
            Rectangle {
                x: 24px;
                y: 188px;
                width: parent.width - 48px;
                height: parent.height - 206px;
                for column[column-index] in root.columns: Rectangle {
                    x: column-index * (parent.width - 104px) / 6;
                    width: 104px;
                    height: parent.height;
                    if column.cards.length == 0: EmptySlot {
                        label: "Empty column\nKings only";
                        activated => { root.tableau-activated(column-index, 0); }
                    }
                    for card[card-index] in column.cards: CardFace {
                        y: card-index * root.fan-spacing(column.cards.length, parent.height / 1px) * 1px;
                        card: card;
                        activated => { root.tableau-activated(column-index, card-index); }
                    }
                }
            }
        }

        if root.game-kind == "Spider": Rectangle {
            background: #0d332e;
            border-radius: 18px;
            vertical-stretch: 1;
            EmptySlot {
                x: 24px;
                y: 22px;
                label: root.stock-count > 0 ? root.stock-count + " cards\nDeal row" : "Stock empty";
                activated => { root.spider-deal-stock(); }
            }
            Text {
                x: 150px;
                y: 62px;
                text: "Completed suited runs  " + root.completed-runs + " of 8";
                color: #dce9e3;
                font-size: 18px;
            }
            Rectangle {
                x: 24px;
                y: 184px;
                width: parent.width - 48px;
                height: parent.height - 202px;
                for column[column-index] in root.columns: Rectangle {
                    x: column-index * (parent.width - 104px) / 9;
                    width: 104px;
                    height: parent.height;
                    if column.cards.length == 0: EmptySlot {
                        label: "Empty Spider column";
                        activated => { root.spider-tableau-activated(column-index, 0); }
                    }
                    for card[card-index] in column.cards: CardFace {
                        y: card-index * root.fan-spacing(column.cards.length, parent.height / 1px) * 1px;
                        card: card;
                        activated => { root.spider-tableau-activated(column-index, card-index); }
                    }
                }
            }
        }

        if root.game-kind == "FreeCell": Rectangle {
            background: #0d332e;
            border-radius: 18px;
            vertical-stretch: 1;
            Rectangle {
                x: 24px;
                y: 22px;
                width: parent.width - 48px;
                height: 150px;
                for card[index] in root.free-cells: Rectangle {
                    x: index * 116px;
                    width: 104px;
                    height: 142px;
                    if root.free-cell-occupied[index]: CardFace {
                        card: card;
                        activated => { root.freecell-cell-activated(index); }
                    }
                    if !root.free-cell-occupied[index]: EmptySlot {
                        label: "Open free cell " + (index + 1);
                        activated => { root.freecell-cell-activated(index); }
                    }
                }
                for foundation[index] in root.foundations: CardFace {
                    x: parent.width - (4 - index) * 116px;
                    card: foundation;
                    activated => { root.freecell-foundation-activated(index); }
                }
            }
            Rectangle {
                x: 24px;
                y: 188px;
                width: parent.width - 48px;
                height: parent.height - 206px;
                for column[column-index] in root.columns: Rectangle {
                    x: column-index * (parent.width - 104px) / 7;
                    width: 104px;
                    height: parent.height;
                    if column.cards.length == 0: EmptySlot {
                        label: "Empty cascade";
                        activated => { root.freecell-cascade-activated(column-index, 0); }
                    }
                    for card[card-index] in column.cards: CardFace {
                        y: card-index * root.fan-spacing(column.cards.length, parent.height / 1px) * 1px;
                        card: card;
                        activated => { root.freecell-cascade-activated(column-index, card-index); }
                    }
                }
            }
        }

        if root.game-kind == "TriPeaks": Rectangle {
            background: #0d332e;
            border-radius: 18px;
            vertical-stretch: 1;

            Rectangle {
                x: 24px;
                y: 18px;
                width: parent.width - 48px;
                height: 382px;
                for item[index] in root.tripeaks-cards: CardFace {
                    x: root.tripeaks-x(index, parent.width / 1px) * 1px;
                    y: index < 3 ? 0px : (index < 9 ? 80px : (index < 18 ? 160px : 240px));
                    visible: item.present;
                    card: item.card;
                    activated => { root.tripeaks-tableau-activated(index); }
                }
            }

            EmptySlot {
                x: 24px;
                y: 420px;
                label: root.stock-count > 0 ? root.stock-count + " cards\nDraw" : "Stock empty";
                activated => { root.tripeaks-draw-stock(); }
            }
            if root.has-waste: CardFace {
                x: 150px;
                y: 420px;
                card: root.waste-card;
                activated => { root.tripeaks-draw-stock(); }
            }
            Text {
                x: 280px;
                y: 458px;
                text: "Clear exposed cards one rank above or below the waste.";
                color: #dce9e3;
                font-size: 18px;
            }
        }

        if root.game-kind == "Pyramid": Rectangle {
            background: #0d332e;
            border-radius: 18px;
            vertical-stretch: 1;

            Rectangle {
                x: 24px;
                y: 18px;
                width: parent.width - 48px;
                height: 382px;
                for item[index] in root.pyramid-cards: CardFace {
                    x: root.pyramid-x(index, parent.width / 1px) * 1px;
                    y: root.pyramid-y(index) * 1px;
                    visible: item.present;
                    card: item.card;
                    activated => { root.pyramid-tableau-activated(index); }
                }
            }

            EmptySlot {
                x: 24px;
                y: 420px;
                label: root.stock-count > 0
                    ? root.stock-count + " cards\nDraw"
                    : (root.redeals-remaining > 0 ? "Recycle waste" : "Stock empty");
                activated => { root.pyramid-draw-stock(); }
            }
            if root.has-waste: CardFace {
                x: 150px;
                y: 420px;
                card: root.waste-card;
                activated => { root.pyramid-waste-activated(); }
            }
            if !root.has-waste: EmptySlot {
                x: 150px;
                y: 420px;
                label: "Pyramid waste empty";
                activated => { root.pyramid-waste-activated(); }
            }
            Text {
                x: 280px;
                y: 444px;
                width: parent.width - 304px;
                text: "Remove exposed pairs totaling 13; remove kings by themselves. Redeals remaining: " + root.redeals-remaining;
                color: #dce9e3;
                font-size: 18px;
                wrap: word-wrap;
            }
        }

    }
}
